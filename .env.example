# Порт на котором запускается сервис
BIND_PORT=5060


########### НАСТРОЙКИ VALKEY 
# Хост на котором развернут valkey
VALKEY_HOST=localhost
# Порт на котором доступен valkey
VALKEY_PORT=6379
# Обязательность авторизации по username и password при подключении к valkey. Значение true обязывает к авторизации
VALKEY_AUTH_REQUIRE=false
# Пользователь, с которого можно подключиться к valkey
VALKEY_USERNAME=user
# Пароль от аккаунта пользователя, с которого можно подключиться к valkey
VALKEY_PASSWORD=pswd
# Номер базы данных valkey, к которой подключается сервис
VALKEY_DB=1

########### НАСТРОЙКИ БАЗЫ ДАННЫХ 
# субд, к которой подключается сервис
DB_TYPE=postgres
# хост, на котором расположена субд
DB_HOST=127.0.0.1
# Порт на котором доступна субд
DB_PORT=5432
# Название базы данных, используяемая в сервисе
DB_NAME=m500
# Пользователь, с которого можно подключиться к базе данных
DB_USER=user
# Пароль от аккаунта пользователя, с которого можно подключиться к базе данных
DB_PASSWORD=pswrd

########### НАСТРОЙКИ ПЕРИОДИЧЕСКОГО ЗАПУСКА ОБНОВЛЕНИЯ КЭША
## CRON-строка которая обозначает периодичность выполнения обновления кэша основных таблиц в sql
CRON_INTERVAL_FOR_UPDATE_STATIC_CACHE=*/1 * * * *
## CRON-строка которая обозначает периодичность выполнения процедуры актуализации кэша для работы с алармами
CRON_INTERVAL_FOR_UPDATE_ALARM_CACHE=*/1 * * * *
## CRON-строка которая обозначает периодичность ыполнения процедуры актуализации кэша списка проверок и списка исключения из проверок
CRON_INTERVAL_FOR_UPDATE_ALARM_CONFIG_BINDS_CACHE=*/1 * * * *
