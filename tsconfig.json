{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "#infrastructure/*": [
        "src/infrastructure/*"
      ],
      "#constants/*": [
        "src/constants/*"
      ],
      "#entities/*": [
        "src/entities/*"
      ],
      "#helpers/*": [
        "src/helpers/*"
      ],
      "#modules/*": [
        "src/modules/*"
      ],
      "#cache/*": [
        "src/modules/cache/*"
      ],
      "#/*": [
        "src/*"
      ]
    }
  }
}